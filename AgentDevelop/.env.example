# 复制为 .env 后填写；.env 不入库（见 .gitignore）
# 教学 Agent 和餐食 Agent 共用 OpenAI 兼容 API Key / 地址。

AGENTDEVELOP_API_KEY=

# 例：DeepSeek / 通义等兼容端点；餐食模型必须支持视觉输入。
AGENTDEVELOP_BASE_URL=https://api.deepseek.com/v1

# 可选，默认 deepseek-chat
AGENTDEVELOP_MODEL=deepseek-chat

# 必填：选择支持图像输入的模型；不回退到纯文本模型。
AGENTDEVELOP_MEAL_MODEL=

# 本机 HealthMind MCP（如运行在其他地址，请改成 HealthMind 的 /mcp URL）。
AGENTDEVELOP_MCP_URL=http://localhost:8100/mcp
AGENTDEVELOP_OAUTH_TOKEN_URL=http://localhost:9000/application/o/token/

# 必须与 HealthMind healthmind.oauth.allowed-dify-client-id 一致；默认值为 dify-healthmind。
AGENTDEVELOP_OAUTH_CLIENT_ID=dify-healthmind
AGENTDEVELOP_OAUTH_CLIENT_SECRET=
AGENTDEVELOP_MCP_SCOPES=healthmind.tool.nutrimemo.capture-context.read healthmind.tool.orion.nutrition-context.read
