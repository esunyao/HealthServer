HEALTHMIND_PORT=8100

# PostgreSQL 数据库设定
HEALTHMIND_DB_URL=jdbc:postgresql://db.example.invalid:5432/Health?currentSchema=healthmind
HEALTHMIND_DB_USERNAME=postgres
HEALTHMIND_DB_PASSWORD=change-me
# 可选
HEALTHMIND_DB_MAX_POOL_SIZE=20
HEALTHMIND_DB_MIN_IDLE=3

# Nacos 配置
NACOS_SERVER_ADDR=nacos.example.invalid:8848
NACOS_GROUP=HEALTH_GROUP
NACOS_USERNAME=healthmind
NACOS_PASSWORD=change-me

# Kafka 配置
KAFKA_BOOTSTRAP_SERVERS=kafka.example.invalid:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_SSL_KEYSTORE_LOCATION=
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_KEY_PASSWORD=

# HealthMind 相关配置
HEALTHMIND_CAPTURE_READY_DESTINATION=nutrition-capture-ready
HEALTHMIND_ANALYSIS_COMPLETED_DESTINATION=nutrition-analysis-completed
HEALTHMIND_ANALYSIS_FAILED_DESTINATION=nutrition-analysis-failed
HEALTHMIND_KAFKA_CONSUMER_GROUP=healthmind-nutrition-v1
HEALTHMIND_KAFKA_PUBLISH_TIMEOUT=15s
# 自托管 LangGraph HTTP 运行端。发布新部署时需在 Nacos 的 healthmind.agent.deployments 增加新 key。
HEALTHMIND_AGENT_BASE_URL=https://agent.example.invalid
HEALTHMIND_AGENT_MAX_IN_FLIGHT=10
HEALTHMIND_AGENT_CONNECT_TIMEOUT=3s
HEALTHMIND_AGENT_READ_TIMEOUT=15s
HEALTHMIND_AGENT_POLL_INTERVAL=5s
HEALTHMIND_SCHEDULER_THREADS=4
HEALTHMIND_SCHEDULER_BATCH_SIZE=10

# HealthMind MCP (M2M) protection for /mcp/**.
AUTHENTIK_ISSUER_URI=https://auth.example.invalid/application/o/healthmind-mcp/
AUTHENTIK_JWK_SET_URI=https://auth.example.invalid/application/o/healthmind-mcp/jwks/
HEALTHMIND_MCP_AUDIENCE=healthmind-mcp
HEALTHMIND_AGENT_CLIENT_ID=langgraph-healthmind
# MCP 资源
HEALTHMIND_MCP_RESOURCE_URI=https://healthmind.example.invalid/mcp
HEALTHMIND_MCP_METADATA_URI=https://healthmind.example.invalid/.well-known/oauth-protected-resource/mcp
HEALTHMIND_INTERNAL_CONNECT_TIMEOUT=3s
HEALTHMIND_INTERNAL_READ_TIMEOUT=15s
# HealthMind 调用 Orion 的 M2M 配置
ORION_OAUTH_CLIENT_ID=healthmind-orion
ORION_INTERNAL_BASE_URL=https://orion.example.invalid
ORION_OAUTH_CLIENT_SECRET=change-me
ORION_OAUTH_AUDIENCE=orion-internal
ORION_OAUTH_SCOPE=orion.ai-context.read
# HealthMind 调用 NutriMemo 的 M2M 配置
NUTRIMEMO_OAUTH_CLIENT_ID=healthmind-nutrimemo
NUTRIMEMO_INTERNAL_BASE_URL=https://nutrimemo.example.invalid
NUTRIMEMO_OAUTH_CLIENT_SECRET=change-me
NUTRIMEMO_OAUTH_AUDIENCE=nutrimemo-internal
NUTRIMEMO_OAUTH_SCOPE=nutrimemo.ai-context.read
# HealthMind 调用 Agent HTTP 服务的 OAuth2 客户端
AGENT_OAUTH_TOKEN_URI=https://auth.example.invalid/application/o/token/
AGENT_OAUTH_CLIENT_ID=healthmind-agent
AGENT_OAUTH_CLIENT_SECRET=change-me
AGENT_OAUTH_AUDIENCE=healthmind-agent
AGENT_OAUTH_SCOPE=healthmind.agent.run
