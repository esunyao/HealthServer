# ============================================================================
# Gateway .env 模板 —— 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# ----------------------------------------------------------------------------
# spring-dotenv 读取模块目录下的 .env 文件；真实环境变量优先于 .env 中的值。
# 对应 application.yaml 中的占位符：${NACOS_USERNAME:}、${JWT_SECRET:} 等。
# ============================================================================

# Nacos 账号
NACOS_SERVER_ADDR=change-me
NACOS_USERNAME=gateway
NACOS_PASSWORD=change-me

# Redis 配置
REDIS_HOST=change-me
REDIS_PORT=change-me
REDIS_PASSWORD=change-me

# JWT 共享密钥
JWT_SECRET=change-me
