# ============================================================================
# Orion .env 模板 —— 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# ----------------------------------------------------------------------------
# spring-dotenv 读取模块目录下的 .env 文件；真实环境变量优先于 .env 中的值。
# 对应 application.yaml 中的占位符：${DB_USERNAME:}、${NACOS_USERNAME:}、
# ${JWT_SECRET:}、${OSS_ACCESS_KEY:} 等。
# ============================================================================

# PostgreSQL 账号
DB_USERNAME=svc_user
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://

# Nacos 账号
NACOS_USERNAME=orion
NACOS_PASSWORD=change-me
NACOS_SERVER_ADDR=
NACOS_GROUP=HEALTH_GROUP

# OSS 对象存储密钥
OSS_ENDPOINT=your-oss-endpoint
OSS_ADDR=your-oss-address
OSS_ACCESS_KEY=your-access-key
OSS_SECRET_KEY=your-secret-key
OSS_BUCKET=your-bucket-name


# Authentik M2M protection for /internal/v1/ai-context/**
ORION_INTERNAL_ISSUER_URI=https://auth.example.invalid/application/o/orion-internal/
ORION_INTERNAL_JWK_SET_URI=https://auth.example.invalid/application/o/orion-internal/jwks/
ORION_INTERNAL_AUDIENCE=orion-internal
ORION_HEALTHMIND_CLIENT_ID=healthmind-orion
