# Copy to .env and configure locally. This template contains no credentials.
# New configuration uses NUTRIATHENA_*; legacy AGENTDEVELOP_* model/MCP keys
# remain accepted by config.py for migration of existing local installations.

# OpenAI-compatible model endpoint; meal model must accept image input.
NUTRIATHENA_MODEL_API_KEY=
NUTRIATHENA_MODEL_BASE_URL=https://api.deepseek.com/v1
NUTRIATHENA_MODEL_ID=deepseek-chat
NUTRIATHENA_MEAL_MODEL_ID=

# HealthMind read-only MCP client (used by the production worker).
NUTRIATHENA_MCP_URL=http://localhost:8100/mcp
NUTRIATHENA_MCP_OAUTH_TOKEN_URL=http://localhost:9000/application/o/token/
NUTRIATHENA_MCP_CLIENT_ID=dify-healthmind
NUTRIATHENA_MCP_CLIENT_SECRET=
NUTRIATHENA_MCP_SCOPES=healthmind.tool.nutrimemo.capture-context.read healthmind.tool.orion.nutrition-context.read
# Exact hostnames that may serve MCP-authorized signed capture images; no wildcard.
NUTRIATHENA_MEDIA_ALLOWED_HOSTS=

# HTTP runtime / PostgreSQL. Run `nutriathena-agent migrate` before `serve`.
NUTRIATHENA_HOST=0.0.0.0
NUTRIATHENA_PORT=8101
NUTRIATHENA_DATABASE_URL=postgresql://nutriathena_agent:change-me@localhost:5432/healthserver
NUTRIATHENA_RELEASE_ID=00000000-0000-0000-0000-000000000000
NUTRIATHENA_DEPLOYMENT_KEY=meal-analysis-v1
NUTRIATHENA_ASSISTANT_ID=nutriathena-meal-agent

# HealthMind -> Agent JWT validation (issuer and JWKS URL must match the issuer).
NUTRIATHENA_OAUTH_ISSUER=http://localhost:9000/application/o/healthmind/
NUTRIATHENA_OAUTH_JWKS_URL=http://localhost:9000/application/o/healthmind/jwks/
NUTRIATHENA_OAUTH_AUDIENCE=healthmind-agent
NUTRIATHENA_OAUTH_CLIENT_ID=healthmind-agent
NUTRIATHENA_OAUTH_SCOPE=healthmind.agent.run

# Optional worker/retention tuning. Results must be retained for at least 24h;
# idempotency metadata is retained for at least 180 days.
NUTRIATHENA_WORKER_POLL_SECONDS=0.5
NUTRIATHENA_LEASE_SECONDS=90
NUTRIATHENA_RUN_TIMEOUT_SECONDS=600
NUTRIATHENA_RESULT_RETENTION_HOURS=24
NUTRIATHENA_ROW_RETENTION_DAYS=180

# Optional safe real smoke; use an already authorized HealthMind task/attempt.
NUTRIATHENA_SMOKE_BASE_URL=http://127.0.0.1:8101
NUTRIATHENA_SMOKE_TOKEN_URL=http://localhost:9000/application/o/token/
NUTRIATHENA_SMOKE_CLIENT_ID=
NUTRIATHENA_SMOKE_CLIENT_SECRET=
NUTRIATHENA_SMOKE_SCOPE=healthmind.agent.run
NUTRIATHENA_SMOKE_TIMEOUT_SECONDS=660
