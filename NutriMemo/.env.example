# NutriMemo .env 模板 —— 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# spring-dotenv 读取模块目录下的 .env 文件；真实环境变量优先于 .env 中的值。
# 对应 application.yaml 中的占位符：${DB_USERNAME:}、${NACOS_USERNAME:}、
# ${NUTRI_OSS_ACCESS_KEY:} 等。

# PostgreSQL 账号
DB_USERNAME=svc_user
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://

# Nacos 账号
NACOS_SERVER_ADDR=
NACOS_USERNAME=nutrimemo
NACOS_PASSWORD=change-me
NACOS_GROUP=HEALTH_GROUP

# OSS 对象存储密钥（变量名前缀为 NUTRI_）
NUTRI_OSS_ENDPOINT=your-oss-endpoint
NUTRI_OSS_ADDR=your-oss-address
NUTRI_OSS_ACCESS_KEY=your-access-key
NUTRI_OSS_SECRET_KEY=your-secret-key
NUTRI_OSS_BUCKET=your-bucket-name
# region 有默认值 us-east-1，可留空
NUTRI_OSS_REGION=us-east-1

# Kafka logical destinations; physical topic mapping may be overridden by Nacos.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_SSL_KEYSTORE_LOCATION=
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_KEY_PASSWORD=

# Kafka Topic 配置
NUTRIMEMO_CAPTURE_READY_DESTINATION=nutrition-capture-ready
NUTRIMEMO_ANALYSIS_COMPLETED_DESTINATION=nutrition-analysis-completed
NUTRIMEMO_ANALYSIS_FAILED_DESTINATION=nutrition-analysis-failed
# Kafka 消费者组
NUTRIMEMO_KAFKA_CONSUMER_GROUP=nutrimemo-analysis-result-v1

# Authentik M2M protection for /internal/v1/analysis-context/**
NUTRIMEMO_INTERNAL_ISSUER_URI=http://192.168.3.101:9000/application/o/nutrimemo-internal/
NUTRIMEMO_INTERNAL_JWK_SET_URI=http://192.168.3.101:9000/application/o/nutrimemo-internal/jwks/
NUTRIMEMO_INTERNAL_AUDIENCE=nutrimemo-internal
NUTRIMEMO_HEALTHMIND_CLIENT_ID=healthmind-nutrimemo
