{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthmind.local/schema/nutrition-analysis-review-required-v1.schema.json",
  "title": "Nutrition Analysis Review Required v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "producer", "trace_id", "subject_id", "aggregate_type", "aggregate_id", "schema_version", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "nutrition.analysis.review_required.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "meal" },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "capture_session_id", "meal_id", "reason_code", "message", "retryable"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "capture_session_id": { "type": "string", "format": "uuid" },
        "meal_id": { "type": "integer", "minimum": 1 },
        "reason_code": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "const": false }
      }
    }
  }
}
