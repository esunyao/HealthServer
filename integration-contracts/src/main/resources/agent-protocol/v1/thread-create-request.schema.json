{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthmind.local/schema/agent-protocol/v1/thread-create-request.schema.json",
  "title": "Agent thread create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["thread_id", "metadata"],
  "properties": {
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "metadata": {
      "$ref": "#/$defs/threadCreateMetadata"
    }
  },
  "$defs": {
    "threadCreateMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id"],
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    }
  }
}
