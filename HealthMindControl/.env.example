HMC_HOST=127.0.0.1
HMC_PORT=8765
HMC_QUERY_LIMIT=100
HMC_AUDIT_PATH=var/audit/admin-actions.jsonl
HMC_DATABASE_DSN=postgresql://user:password@db.example.invalid:5432/Health
HMC_KAFKA_BOOTSTRAP_SERVERS=kafka.example.invalid:9092
HMC_DIFY_URL=https://dify.example.invalid
HMC_MCP_URL=https://mcp.example.invalid/mcp
HMC_AUTH_URL=https://auth.example.invalid
# 首次使用前运行 difyctl auth login；HMC 只调用 CLI，不读取其 OAuth 凭据
HMC_DIFYCTL_PATH=/path/to/difyctl
# 可选：实验台直接走 NutriMemo API 创建/上传/提交时使用
HMC_NUTRI_API_URL=https://nutri.example.invalid
# 专家 SQL 与消费组 offset 工具，默认必须关闭
HMC_ENABLE_EXPERT_MODE=false
HMC_DEBUG_DB_PATH=var/debug/control.sqlite3
HMC_DATABASE_POOL_MIN_SIZE=1
HMC_DATABASE_POOL_MAX_SIZE=8
HMC_FIXTURE_MCP_LEASE_MINUTES=50
HMC_FIXTURE_REAPER_SECONDS=10


# ---- Kafka 认证（可选）----
# 集群启用 SASL/SSL 时按需配置；凭据只保存在本机 .env，绝不入库/入审计
# HMC_KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # PLAINTEXT | SASL_PLAINTEXT | SSL | SASL_SSL
# HMC_KAFKA_SASL_MECHANISM=PLAIN          # 或 SCRAM-SHA-256 / SCRAM-SHA-512
# HMC_KAFKA_SASL_USERNAME=
# HMC_KAFKA_SASL_PASSWORD=
# HMC_KAFKA_SSL_CA_LOCATION=
